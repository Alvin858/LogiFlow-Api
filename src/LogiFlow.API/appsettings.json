{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LogiFlowDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "LogiFlow",
    "Audience": "LogiFlowUsers",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@logiflow.local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
